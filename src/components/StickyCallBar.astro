---
/**
 * Mobile-only sticky contact bar. Renders one, two or three real actions:
 * call and WhatsApp appear only when the shop's numbers are in shop.ts,
 * directions is always there. No placeholder destinations.
 */
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import { telHref, whatsappHref, MAP_DIRECTIONS_URL } from "@/lib/shop";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copyFor(lang);
const tel = telHref();
const wa = whatsappHref(lang === "te" ? "నమస్కారం, ఫీడ్, చెరువు సరుకుల గురించి అడగాలనుకుంటున్నాను." : "Namaste, I would like to ask about feed and pond supplies.");

const actions = [
  tel && { href: tel, icon: "ph-phone", label: t.visit.callCta, tone: "text-coral-ink", external: false },
  wa && { href: wa, icon: "ph-whatsapp-logo", label: "WhatsApp", tone: "text-lagoon-deep", external: true },
  { href: MAP_DIRECTIONS_URL, icon: "ph-map-pin", label: t.hero.directionsCta, tone: "text-lagoon-deep", external: true },
].filter(Boolean) as { href: string; icon: string; label: string; tone: string; external: boolean }[];
---

<div
  class="fixed inset-x-3 bottom-3 z-40 grid gap-2 rounded-2xl border border-navy/10 bg-cream/90 p-2 backdrop-blur-xl sm:hidden"
  style={`grid-template-columns: repeat(${actions.length}, minmax(0, 1fr));`}
  role="navigation"
  aria-label={t.nav.quickContact}
>
  {
    actions.map((action) => (
      <a
        href={action.href}
        target={action.external ? "_blank" : undefined}
        rel={action.external ? "noopener" : undefined}
        class="flex cursor-pointer flex-col items-center gap-1 rounded-xl py-2 text-[11px] font-bold text-navy hover:bg-navy/5"
      >
        <i class={`ph-light ${action.icon} text-[19px] ${action.tone}`} aria-hidden="true" />
        {action.label}
      </a>
    ))
  }
</div>
