---
/**
 * The actions a farmer actually needs, and only the ones that work.
 *
 * Call and WhatsApp render only once the shop's numbers are in shop.ts; with
 * no number there is no button, rather than a control that leads somewhere
 * else. Directions is a real link at all times.
 */
import type { Lang } from "@/content/aqua-copy";
import { pagesCopyFor } from "@/content/pages-copy";
import { telHref, whatsappHref, MAP_DIRECTIONS_URL } from "@/lib/shop";

interface Props {
  lang: Lang;
  /** Directions is a real link; drop it where the page already shows a map. */
  directions?: boolean;
}
const { lang, directions = true } = Astro.props;
const t = pagesCopyFor(lang);
const tel = telHref();
const wa = whatsappHref(
  lang === "te"
    ? "నమస్కారం, ఫీడ్, చెరువు సరుకుల గురించి అడగాలనుకుంటున్నాను."
    : "Namaste, I would like to ask about feed and pond supplies.",
);

const primaryClass =
  "group inline-flex cursor-pointer items-center gap-3 rounded-full bg-coral px-6 py-3 font-display text-[15px] font-bold text-navy transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:bg-coral-deep hover:text-cream active:translate-y-px active:scale-[0.98]";
const ghostClass =
  "group inline-flex cursor-pointer items-center gap-3 rounded-full border border-current/25 px-6 py-3 font-display text-[15px] font-bold transition-all duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] hover:-translate-y-px active:translate-y-px active:scale-[0.98]";
---

<div class="flex flex-wrap items-center gap-3">
  {
    tel && (
      <a href={tel} class={primaryClass}>
        <i class="ph-light ph-phone text-[20px]" aria-hidden="true" />
        {t.callLabel}
      </a>
    )
  }

  {
    wa && (
      <a href={wa} target="_blank" rel="noopener" class={ghostClass}>
        <i class="ph-light ph-whatsapp-logo text-[20px]" aria-hidden="true" />
        {t.whatsappLabel}
      </a>
    )
  }

  {
    directions && (
      <a
        href={MAP_DIRECTIONS_URL}
        target="_blank"
        rel="noopener"
        class={tel ? ghostClass : primaryClass}
      >
        <i class="ph-light ph-map-pin text-[20px]" aria-hidden="true" />
        {t.directionsLabel}
        <span
          class="flex size-7 items-center justify-center rounded-full bg-navy/10 transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-1"
        >
          <i class="ph-light ph-arrow-up-right text-[13px]" aria-hidden="true" />
        </span>
      </a>
    )
  }
</div>
