---
/**
 * The honest gap: a placeholder the shop still has to supply. Close to the
 * existing <FillIn> semantics of the old build. `text` replaces the literal
 * where a sentence is clearer.
 */
import { FILL } from "@/lib/shop";

interface Props {
  text?: string;
}
const { text = FILL } = Astro.props;
---

<mark class="fill-in rounded-full">{text}</mark>
