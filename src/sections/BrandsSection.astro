---
/**
 * The Brand Ledger: an editorial index of every brand name we stock, rendered
 * at build time from /public/data/brands.json so the alphabet, the count, the
 * search and the PDF can never drift from one list.
 *
 * Layout is a field-notebook index: serif letter headings (Fraunces, and the
 * Telugu face under /te via --font-ledger), hairline-ruled text rows in
 * columns, no cards. The client script only filters and counts: all names are
 * in the HTML, so the ledger works without JS.
 */
import type { Lang } from "@/content/aqua-copy";
import { pagesCopyFor } from "@/content/pages-copy";
import { BRANDS, BRAND_COUNT, BRAND_LETTERS, BRAND_SAMPLE, asOfLabel } from "@/lib/brands";
import DownloadPdf from "@/components/DownloadPdf.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const b = pagesCopyFor(lang).brands;

const a1 = `${b.faq.a1Head.replace("{count}", String(BRAND_COUNT))} ${BRAND_SAMPLE.join(", ")}. ${b.faq.a1Tail}`;
const metaNote = b.metaNote.replace("{date}", asOfLabel(lang));
const showingAll = b.showing.replace("{n}", String(BRAND_COUNT)).replace("{total}", String(BRAND_COUNT));

const groups = BRAND_LETTERS.map((letter) => ({
  letter,
  names: BRANDS.filter((brand) => brand.name[0].toUpperCase() === letter).map((brand) => brand.name),
})).filter((group) => group.names.length > 0);

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    { "@type": "Question", name: b.faq.q1, acceptedAnswer: { "@type": "Answer", text: a1 } },
    { "@type": "Question", name: b.faq.q2, acceptedAnswer: { "@type": "Answer", text: b.faq.a2 } },
  ],
};
---

<section
  id="brands"
  aria-labelledby="brands-heading"
  class="ledger scroll-mt-24 border-t border-navy/12 bg-cream-deep py-20 sm:py-28"
>
  <div class="mx-auto w-full max-w-6xl px-5">
    <div class="grid items-end gap-10 lg:grid-cols-[1.35fr_0.65fr]">
      <div>
        <p class="font-display text-[11px] font-bold uppercase tracking-[0.22em] text-coral-ink">
          {b.overline}
        </p>
        <h2
          id="brands-heading"
          data-reveal="0"
          class="mt-4 max-w-[16ch] font-ledger text-4xl leading-[1.05] sm:text-6xl sm:leading-[1.02]"
        >
          {b.heading}
        </h2>
        <p data-reveal="1" class="mt-3 text-[17px] font-semibold text-lagoon-deep">{b.headingAlt}</p>
        <p data-reveal="2" class="mt-5 max-w-[56ch] text-lg leading-8 text-navy-soft">{b.lead}</p>
      </div>
      <div data-reveal="2" class="lg:text-right">
        <span
          id="brand-count"
          class="block font-ledger text-[clamp(4.5rem,12vw,8rem)] leading-none text-lagoon-deep"
        >
          {BRAND_COUNT}
        </span>
        <span class="mt-1 block font-display text-[12px] font-bold uppercase tracking-[0.2em] text-navy-soft">
          {b.countLabel}
        </span>
        <span class="mt-3 block text-[13px] leading-6 text-navy-soft">{metaNote}</span>
      </div>
    </div>

    <!-- Controls. Stays under the floating nav while the ledger scrolls. -->
    <div
      id="brand-controls"
      class="sticky top-16 z-10 mt-12 border-y border-navy/15 bg-cream-deep/95 py-3 backdrop-blur sm:top-20"
    >
      <div class="flex flex-wrap items-center gap-3">
        <div class="relative min-w-[15rem] flex-1">
          <i
            class="ph-light ph-magnifying-glass pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[18px] text-navy-soft"
            aria-hidden="true"
          />
          <label class="sr-only" for="brand-search">{b.searchPlaceholder}</label>
          <input
            id="brand-search"
            type="search"
            autocomplete="off"
            placeholder={b.searchPlaceholder}
            class="h-12 w-full rounded-full border border-navy/25 bg-cream pl-11 pr-4 text-[16px] font-semibold text-navy placeholder:text-navy-soft/70 focus:border-lagoon focus:outline-2 focus:outline-offset-2 focus:outline-lagoon/40"
          />
        </div>
        <button
          id="brand-clear"
          type="button"
          hidden
          class="inline-flex h-12 cursor-pointer items-center gap-2 rounded-full px-4 text-[14px] font-bold text-coral-ink hover:bg-navy/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lagoon"
        >
          <i class="ph-light ph-x text-[16px]" aria-hidden="true" />
          {b.searchClear}
        </button>
        <p
          id="brand-results"
          data-template={b.showing}
          role="status"
          aria-live="polite"
          class="ml-auto text-[13px] font-bold text-navy-soft"
        >
          {showingAll}
        </p>
      </div>

      <ul role="list" aria-label={b.lettersLabel} class="mt-3 flex flex-wrap gap-1.5">
        {
          groups.map((group) => (
            <li>
              <button
                type="button"
                data-jump-letter={group.letter}
                aria-pressed="false"
                class="size-8 cursor-pointer rounded-full border border-navy/20 font-ledger text-[14px] text-navy transition-colors hover:border-navy/50 hover:bg-navy/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lagoon"
              >
                {group.letter}
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- The ledger: every name, grouped by letter, in columns of ruled rows. -->
    <div id="brand-ledger" class="mt-10 flex flex-col gap-9">
      {
        groups.map((group) => (
          <section data-brand-group={group.letter} class="grid gap-3 sm:grid-cols-[3rem_1fr] sm:gap-6">
            <h3 class="font-ledger text-3xl leading-none text-lagoon-deep" aria-hidden="true">
              {group.letter}
            </h3>
            <ul role="list" class="columns-1 gap-x-10 sm:columns-2 lg:columns-3">
              {group.names.map((name) => (
                <li
                  data-brand-row
                  data-name={name.toLowerCase()}
                  data-row-letter={group.letter}
                  class="ledger-row break-inside-avoid border-b border-navy/10 py-2 text-[15px] font-semibold text-navy last:border-b-0"
                >
                  {name}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <p
      id="brand-empty"
      hidden
      class="mt-8 border-l-2 border-coral pl-5 text-[15px] font-semibold leading-7 text-navy"
    >
      {b.emptyState}
    </p>

    <div class="mt-12 flex flex-col gap-6 border-t border-navy/15 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <DownloadPdf {lang} />
      <p class="max-w-[38ch] text-[13px] leading-6 text-navy-soft">{metaNote}</p>
    </div>

    <div class="mt-14 grid gap-8 border-t border-navy/12 pt-10 sm:grid-cols-2 sm:gap-14">
      <div>
        <h3 class="font-display text-lg font-extrabold tracking-tight text-navy">{b.faq.q1}</h3>
        <p class="mt-2 max-w-[60ch] text-[15px] leading-7 text-navy-soft">{a1}</p>
      </div>
      <div>
        <h3 class="font-display text-lg font-extrabold tracking-tight text-navy">{b.faq.q2}</h3>
        <p class="mt-2 max-w-[60ch] text-[15px] leading-7 text-navy-soft">{b.faq.a2}</p>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<script>
  const search = document.getElementById("brand-search") as HTMLInputElement | null;
  const clear = document.getElementById("brand-clear");
  const results = document.getElementById("brand-results");
  const empty = document.getElementById("brand-empty");
  const rows = [...document.querySelectorAll<HTMLLIElement>("[data-brand-row]")];
  const groups = [...document.querySelectorAll<HTMLElement>("[data-brand-group]")];
  const letters = [...document.querySelectorAll<HTMLButtonElement>("[data-jump-letter]")];

  if (search && results && rows.length > 0) {
    const template = results.dataset.template ?? "";
    const total = rows.length;
    let activeLetter = "";

    const apply = () => {
      const query = search.value.trim().toLowerCase();
      const safe = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const exact = safe ? new RegExp(`(^|\\s)${safe}`) : null;
      const loose = safe ? new RegExp(safe) : null;
      let shown = 0;
      const reachable = new Set<string>();

      for (const row of rows) {
        const name = row.dataset.name ?? "";
        const letter = row.dataset.rowLetter ?? "";
        // Prefix matches first, so "aqua" finds "Aqua Boat" ahead of "Nurture Aqua".
        const matches = !query || exact?.test(name) || loose?.test(name) || false;
        if (matches) reachable.add(letter);
        const ok = matches && (!activeLetter || letter === activeLetter);
        row.hidden = !ok;
        if (ok) shown++;
      }

      for (const group of groups) {
        const letter = group.dataset.brandGroup ?? "";
        group.hidden = !reachable.has(letter) || (activeLetter !== "" && activeLetter !== letter);
      }

      for (const button of letters) {
        const letter = button.dataset.jumpLetter ?? "";
        const has = reachable.has(letter);
        button.disabled = !has;
        button.classList.toggle("opacity-25", !has);
        const active = activeLetter === letter;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("bg-navy", active);
        button.classList.toggle("text-cream", active);
      }

      results.textContent = template.replace("{n}", String(shown)).replace("{total}", String(total));
      if (empty) empty.hidden = shown > 0;
      if (clear) clear.hidden = !(query || activeLetter);
    };

    search.addEventListener("input", apply);

    search.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        search.value = "";
        activeLetter = "";
        apply();
      }
    });

    clear?.addEventListener("click", () => {
      search.value = "";
      activeLetter = "";
      apply();
      search.focus();
    });

    for (const button of letters) {
      button.addEventListener("click", () => {
        const letter = button.dataset.jumpLetter ?? "";
        activeLetter = activeLetter === letter ? "" : letter;
        apply();
        if (activeLetter) {
          const group = groups.find((g) => g.dataset.brandGroup === activeLetter);
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          group?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
        }
      });
    }

    apply();
  }
</script>

<style>
  /* Water contours, drawn rather than photographed, so nothing here pretends
     to be a picture of the shop. */
  .ledger {
    background-image: repeating-radial-gradient(
      circle at 8% 4%,
      rgb(10 95 104 / 0.055) 0 1px,
      transparent 1px 16px
    );
  }
</style>
