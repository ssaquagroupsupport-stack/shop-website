---
/** Around the ponds: a size-varied bento of photographs on the deep lagoon
 * band. Each cell = one real photo, no filler tiles. */
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import SmartImage from "@/components/SmartImage.astro";
import type { PhotoKey } from "@/lib/photos";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copyFor(lang);

const tiles: { key: PhotoKey; caption: string; span: string }[] = [
  { key: "basketsOfShrimp", caption: t.mosaic.captions.baskets, span: "sm:col-span-2 sm:row-span-2" },
  { key: "feedingThePond", caption: t.mosaic.captions.feeding, span: "" },
  { key: "atThePondEdge", caption: t.mosaic.captions.edge, span: "" },
  { key: "workingWater", caption: t.mosaic.captions.water, span: "" },
  { key: "pondFromAbove", caption: t.mosaic.captions.ponds, span: "sm:col-span-2" },
];
---

<section class="bg-lagoon-deep py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-5">
    <h2 data-reveal="0" class="max-w-xl font-display text-3xl font-extrabold leading-tight tracking-tight text-cream sm:text-5xl">
      {t.mosaic.title}
    </h2>
    <p data-reveal="1" class="mt-4 max-w-[52ch] text-lg text-cream/75">{t.mosaic.lead}</p>

    <div class="mt-14 grid gap-3 sm:grid-cols-4 sm:grid-rows-2">
      {
        tiles.map((tile, i) => (
          <figure data-reveal={i} class:list={["group relative overflow-hidden rounded-[1.4rem]", tile.span]}>
            <SmartImage
              photoKey={tile.key}
              widths={[450, 800]}
              sizes="(max-width: 640px) 100vw, 40vw"
              class="h-64 w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-[1.04] sm:h-full sm:min-h-56"
            />
            <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-deep/80 to-transparent p-4 pt-10 text-[13px] font-semibold text-cream">
              {tile.caption} <span class="text-cream/50">({t.stockPhotoLabel})</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
