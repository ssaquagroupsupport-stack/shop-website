---
/** Hero: full-bleed aerial pond photo under a navy scrim, left-aligned
 * message block, pill CTAs with nested arrow. Fit inside the first viewport. */
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import CtaButtons from "@/components/CtaButtons.astro";
import SmartImage from "@/components/SmartImage.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copyFor(lang);
---

<section class="relative flex min-h-[100dvh] items-end overflow-hidden bg-navy-deep">
  <div class="absolute inset-0">
    <SmartImage
      photoKey="hero"
      widths={[800, 1400]}
      sizes="100vw"
      eager
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-deep via-navy-deep/55 to-navy-deep/20"></div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-5 pb-28 pt-40 sm:pb-32">
    <div class="max-w-2xl">
      <p data-reveal="0" class="mb-4 font-display text-[12px] font-bold uppercase tracking-[0.18em] text-lime">
        {t.hero.title}
      </p>
      <h1 data-reveal="1" class="max-w-[46rem] font-display text-4xl font-extrabold leading-[1.02] text-cream sm:text-5xl lg:text-6xl">
        <span class="block">{t.hero.h1Brand}</span>
        <span class="mt-3 block text-[0.52em] font-bold leading-[1.15] text-cream/85 sm:mt-4">
          {t.hero.h1Tail}
        </span>
      </h1>
      <p data-reveal="2" class="mt-6 max-w-xl text-lg leading-8 text-cream/80 sm:text-xl">
        {t.hero.lead}
      </p>
      <div data-reveal="3" class="mt-9 text-cream">
        <CtaButtons {lang} directions={false} />
      </div>
    </div>
  </div>

  <p class="absolute bottom-4 right-5 hidden text-[11px] text-cream/50 sm:block">
    {t.stockPhotoLabel} · {t.hero.photoCaption}
  </p>
</section>
