---
/** Closing band: how to reach a human, navy. */
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import CtaButtons from "@/components/CtaButtons.astro";

interface Props {
  lang: Lang;
  lead?: string;
  heading?: string;
}
const { lang } = Astro.props;
const t = copyFor(lang);
const heading = Astro.props.heading ?? t.visit.title;
const lead = Astro.props.lead ?? t.visit.lead;
---

<section class="bg-navy py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-5">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-xl">
        <h2 data-reveal="0" class="font-display text-3xl font-extrabold leading-tight tracking-tight text-cream sm:text-5xl sm:leading-[1.08]">
          {heading}
        </h2>
        <p data-reveal="1" class="mt-4 max-w-[52ch] text-lg leading-8 text-cream/75">{lead}</p>
        <p data-reveal="2" class="mt-5 text-[13px] font-bold uppercase tracking-[0.18em] text-cream/50">
          {t.hero.hours}
        </p>
      </div>
      <div data-reveal="3" class="text-cream">
        <CtaButtons {lang} />
      </div>
    </div>
  </div>
</section>
