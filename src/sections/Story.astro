---
/** Story band: editorial cream section, the owner's portrait, the timeline as
 * a ruled column (not a bullet list). */
import { Image } from "astro:assets";
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import owner from "@/assets/owner.webp";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copyFor(lang);
---

<section class="relative overflow-hidden bg-cream py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-5">
    <div class="grid items-center gap-16 lg:grid-cols-[1fr_1.1fr]">
      <figure class="relative">
        <Image
          src={owner}
          widths={[520, 900]}
          sizes="(max-width: 1024px) 100vw, 46vw"
          alt={t.story.ownerAlt}
          class="w-full rounded-[1.6rem] border border-navy/10"
        />
        <figcaption
          class="mt-4 flex items-center gap-2.5 text-[13px] font-semibold text-navy-soft"
        >
          <span class="h-px w-8 bg-coral-ink" aria-hidden="true"></span>
          {t.story.ownerCaption}
        </figcaption>
      </figure>

      <div class="flex flex-col gap-8">
        <div>
          <h2 data-reveal="0" class="font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-[2.6rem] sm:leading-[1.1]">
            {t.story.title}
          </h2>
          <p data-reveal="1" class="mt-5 max-w-[60ch] text-lg leading-8 text-navy-soft">
            {t.story.lead}
          </p>
        </div>

        <ol class="relative ml-2 flex flex-col gap-7 border-l border-navy/15 pl-7">
          {
            t.story.timeline.map((row, i) => (
              <li data-reveal={i} class="relative">
                <span class="absolute -left-[35px] top-1.5 size-3 rounded-full border-2 border-coral-ink bg-cream" aria-hidden="true" />
                <p class="font-display text-[12px] font-bold uppercase tracking-[0.18em] text-coral-ink">{row.year}</p>
                <p class="mt-0.5 font-display text-lg font-bold text-navy">{row.title}</p>
                <p class="mt-1 max-w-[52ch] text-[15px] leading-6 text-navy-soft">{row.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
