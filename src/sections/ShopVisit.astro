---
/**
 * The shop: NAP, hours, map, and a drawn counter card instead of an empty
 * photo frame (the shop's own photographs do not exist yet, so nothing here
 * pretends to be one). Map iframe is lazy (below fold). */
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import {
  NAME,
  ADDRESS_LINES,
  hoursLine,
  MAP_EMBED_URL,
  SAME_AS,
} from "@/lib/shop";
import DropMark from "@/components/DropMark.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copyFor(lang);
const mapTitle = t.hero.directionsCta;
const name = lang === "te" && NAME.te ? NAME.te : NAME.en;
---

<section id="shop" class="bg-cream-deep py-24 sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-5">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr]">
      <div class="flex flex-col gap-8">
        <div>
          <h2 data-reveal="0" class="font-display text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl sm:leading-[1.08]">
            {t.shop.title}
          </h2>
          <p data-reveal="1" class="mt-4 max-w-[54ch] text-lg leading-8 text-navy-soft">{t.shop.lead}</p>
        </div>

        <dl data-reveal="2" class="flex flex-col gap-0 border-t border-navy/12">
          <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-navy/12 py-4">
            <dt class="font-display text-[12px] font-bold uppercase tracking-[0.16em] text-navy-soft">
              {t.shop.addressLabel}
            </dt>
            <dd class="text-right text-[15px] font-semibold leading-6 text-navy">
              {ADDRESS_LINES.map((l) => <span class="block">{l}</span>)}
            </dd>
          </div>
          <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-navy/12 py-4">
            <dt class="font-display text-[12px] font-bold uppercase tracking-[0.16em] text-navy-soft">
              {t.shop.hoursLabel}
            </dt>
            <dd class="text-right text-[15px] font-semibold text-navy">
              {hoursLine()}
            </dd>
          </div>
        </dl>

        {SAME_AS.length > 0 && (
          <div data-reveal="3" class="flex flex-wrap gap-3">
            {
              SAME_AS.map((url) => (
                <a href={url} target="_blank" rel="noopener" class="rounded-full border border-navy/20 px-4 py-2 text-[13px] font-bold text-navy hover:bg-navy/5">
                  {new URL(url).hostname.replace("www.", "")}
                </a>
              ))
            }
          </div>
        )}
      </div>

      <div data-reveal="1" class="flex flex-col gap-6">
        <figure class="overflow-hidden rounded-[1.4rem] border border-navy/10">
          <iframe
            src={MAP_EMBED_URL}
            width="640"
            height="360"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={mapTitle}
            class="h-72 w-full border-0 sm:h-96"
          />
          <figcaption class="bg-cream px-4 py-3 text-[12px] text-navy-soft">{t.shop.mapNote}</figcaption>
        </figure>

        <div
          data-reveal="2"
          class="counter-card relative overflow-hidden rounded-[1.4rem] border border-navy/12 bg-cream p-6"
        >
          <div class="flex items-center gap-3">
            <DropMark class="size-10 text-lagoon-deep" />
            <div>
              <p class="font-display text-lg font-extrabold tracking-tight text-navy" lang={lang}>{name}</p>
              <p class="text-[12px] font-bold uppercase tracking-[0.16em] text-navy-soft">{t.footer.sealLabel}</p>
            </div>
          </div>
          <address class="mt-5 not-italic text-[14px] leading-7 text-navy-soft">
            {ADDRESS_LINES.map((l) => <span class="block">{l}</span>)}
          </address>
          <p class="mt-4 flex items-center gap-2 text-[14px] font-semibold text-navy">
            <i class="ph-light ph-clock text-[18px] text-lagoon-deep" aria-hidden="true" />
            {hoursLine()}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Water contours, drawn rather than photographed. */
  .counter-card {
    background-image: repeating-radial-gradient(
      circle at 90% 10%,
      rgb(10 95 104 / 0.06) 0 1px,
      transparent 1px 14px
    );
  }
</style>
