---
/** One shelf, one page: photo split intro, three working rules, brands marker,
 * the other shelves, and the counter CTA. */
import Base from "@/layouts/Base.astro";
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import { pagesCopyFor } from "@/content/pages-copy";
import type { Category } from "@/lib/pages";
import type { PhotoKey } from "@/lib/photos";
import SmartImage from "@/components/SmartImage.astro";
import WaveDivider from "@/components/WaveDivider.astro";
import VisitCta from "@/sections/VisitCta.astro";

interface Props {
  lang: Lang;
  category: Category;
}
const { lang, category } = Astro.props;
const p = pagesCopyFor(lang);
const cat = p.categories[category];
const href = (c: Category) => (lang === "te" ? `/te/products/${c}` : `/products/${c}`);
---

<Base {lang} slug={`products/${category}`}>
  <section class="mx-auto w-full max-w-6xl px-5 pt-36 pb-10 sm:pt-44">
    <nav aria-label="Breadcrumb" class="mb-8 text-[13px] font-semibold text-navy-soft">
      <a href={lang === "te" ? "/te" : "/"} class="hover:text-navy">{p.nav.home}</a>
      <span class="px-1.5 text-navy/40" aria-hidden="true">/</span>
      <a href={lang === "te" ? "/te/products" : "/products"} class="hover:text-navy">{p.nav.products}</a>
      <span class="px-1.5 text-navy/40" aria-hidden="true">/</span>
      <span aria-current="page">{cat.name}</span>
    </nav>

    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <h1 data-reveal="0" class="max-w-[22ch] font-display text-4xl font-extrabold leading-[1.06] tracking-tight sm:text-6xl sm:leading-[1.03]">
          {cat.heading}
        </h1>
        <p data-reveal="1" class="mt-6 max-w-[60ch] text-lg leading-8 text-navy-soft sm:text-xl">
          {cat.intro}
        </p>
        <p data-reveal="2" class="mt-5 text-[14px] font-semibold text-navy-soft">
          {cat.brandsNote}
        </p>
      </div>
      <figure data-reveal="1" class="relative">
        <SmartImage
          photoKey={cat.photoKey as PhotoKey}
          widths={[500, 900]}
          sizes="(max-width: 1024px) 100vw, 42vw"
          class="w-full rounded-[1.6rem] border border-navy/10 object-cover"
        />
        <figcaption class="mt-2 text-[11px] text-navy-soft">
          {p.stockPhotoLabel}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-cream-deep py-20 sm:py-24">
    <div class="mx-auto w-full max-w-6xl px-5">
      <div class="border-t border-navy/12">
        {
          cat.points.map((point) => (
            <div data-reveal="1" class="grid gap-2 border-b border-navy/12 py-8 sm:grid-cols-[0.9fr_1.4fr] sm:gap-14">
              <h2 class="max-w-[24ch] font-display text-xl font-extrabold tracking-tight text-navy sm:text-2xl">
                {point.title}
              </h2>
              <p class="max-w-[62ch] text-[15px] leading-7 text-navy-soft">{point.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream py-20 sm:py-24">
    <div class="mx-auto w-full max-w-6xl px-5">
      <p class="font-display text-[12px] font-bold uppercase tracking-[0.18em] text-navy-soft">
        {copyFor(lang).products.otherTitle}
      </p>
      <ul class="mt-5 flex flex-wrap gap-2.5">
        {
          Object.values(p.categories).map((c) => (
            <li>
              <a
                href={href(c.slug)}
                class:list={[
                  "block cursor-pointer rounded-full border border-navy/20 px-4 py-2 text-[14px] font-bold transition-all duration-500 hover:-translate-y-px hover:border-navy/40",
                  c.slug === category ? "bg-lime border-transparent text-navy" : "text-navy",
                ]}
              >
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <WaveDivider from="var(--color-cream)" to="var(--color-navy)" />
  <VisitCta {lang} />
</Base>
