---
/** Story page: the landing story block plus the closing note and the counter
 * CTA. Same timeline data, fuller lead. */
import Base from "@/layouts/Base.astro";
import type { Lang } from "@/content/aqua-copy";
import { copyFor } from "@/content/aqua-copy";
import { pagesCopyFor } from "@/content/pages-copy";
import { YEARS_TRADING } from "@/lib/shop";
import Story from "@/sections/Story.astro";
import WaveDivider from "@/components/WaveDivider.astro";
import VisitCta from "@/sections/VisitCta.astro";
import SmartImage from "@/components/SmartImage.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sp = pagesCopyFor(lang).storyPage;
const t = copyFor(lang);
---

<Base {lang} slug="story">
  <section class="mx-auto w-full max-w-6xl px-5 pt-36 pb-4 sm:pt-44">
    <nav aria-label="Breadcrumb" class="mb-8 text-[13px] font-semibold text-navy-soft">
      <a href={lang === "te" ? "/te" : "/"} class="hover:text-navy">{lang === "te" ? "హోమ్" : "Home"}</a>
      <span class="px-1.5 text-navy/40" aria-hidden="true">/</span>
      <span aria-current="page">{pagesCopyFor(lang).nav.story}</span>
    </nav>
    <header class="max-w-3xl">
      <p data-reveal="0" class="mb-5 font-display text-[11px] font-bold uppercase tracking-[0.2em] text-coral-ink">
        {YEARS_TRADING} {copyFor(lang).stats.yearsLabel}
      </p>
      <h1 data-reveal="1" class="font-display text-4xl font-extrabold leading-[1.06] tracking-tight sm:text-6xl">
        {sp.h1}
      </h1>
      <p data-reveal="2" class="mt-6 max-w-[62ch] text-lg leading-8 text-navy-soft sm:text-xl">
        {sp.lead}
      </p>
    </header>
  </section>

  <Story {lang} />

  <section class="bg-cream-deep py-20">
    <div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-5 sm:grid-cols-[1fr_1.2fr]">
      <SmartImage
        photoKey="paddyDelta"
        widths={[500, 900]}
        sizes="(max-width: 640px) 100vw, 42vw"
        class="rounded-[1.4rem] border border-navy/10"
      />
      <p data-reveal="1" class="max-w-[58ch] font-display text-2xl font-bold leading-9 text-navy sm:text-[1.7rem]">
        {sp.closing}
      </p>
    </div>
  </section>

  <WaveDivider from="var(--color-cream-deep)" to="var(--color-navy)" />
  <VisitCta heading={t.visit.title} {lang} />
</Base>
