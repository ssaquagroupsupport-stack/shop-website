---
/** Home: hero, one marquee, stats, story, shelf index, brands, trust, counter
 * notes, shop, visit. Seams = wave dividers like the old build. */
import Base from "@/layouts/Base.astro";
import type { Lang } from "@/content/aqua-copy";
import Hero from "@/sections/Hero.astro";
import Marquee from "@/components/Marquee.astro";
import StatsBand from "@/sections/StatsBand.astro";
import Story from "@/sections/Story.astro";
import WaveDivider from "@/components/WaveDivider.astro";
import ShelfIndex from "@/sections/ShelfIndex.astro";
import BrandsSection from "@/sections/BrandsSection.astro";
import Trust from "@/sections/Trust.astro";
import SeasonNotes from "@/sections/SeasonNotes.astro";
import ShopVisit from "@/sections/ShopVisit.astro";
import VisitCta from "@/sections/VisitCta.astro";
import FeedbackForm from "@/sections/FeedbackForm.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// The feedback section only exists once the sheet URL is set, so its wave
// seam is gated the same way: no dangling bone band above the footer.
const hasFeedback = Boolean(import.meta.env.PUBLIC_FEEDBACK_URL);
---

<Base {lang} slug="">
  <Hero {lang} />
  <WaveDivider from="var(--color-navy-deep)" to="var(--color-lime)" />
  <Marquee />
  <WaveDivider from="var(--color-lime)" to="var(--color-cream-deep)" />
  <StatsBand {lang} />
  <Story {lang} />
  <ShelfIndex {lang} />
  <BrandsSection {lang} />
  <WaveDivider from="var(--color-cream)" to="var(--color-paddy)" />
  <Trust {lang} />
  <SeasonNotes {lang} />
  <WaveDivider from="var(--color-amber)" to="var(--color-cream-deep)" />
  <ShopVisit {lang} />
  <WaveDivider from="var(--color-cream-deep)" to="var(--color-navy)" />
  <VisitCta {lang} />
  {
    hasFeedback && (
      <>
        <WaveDivider from="var(--color-navy)" to="var(--color-bone)" />
        <FeedbackForm {lang} />
      </>
    )
  }
</Base>
