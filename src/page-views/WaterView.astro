---
/** water parameters page: the same table as the home band, given the room to read it
 * properly, plus the two footnotes that keep it honest. */
import Base from "@/layouts/Base.astro";
import type { Lang } from "@/content/aqua-copy";
import { waterCopyFor } from "@/content/water-copy";
import { WATER_ROW_COUNT } from "@/lib/water";
import WaterTable from "@/sections/WaterTable.astro";
import WaveDivider from "@/components/WaveDivider.astro";
import VisitCta from "@/sections/VisitCta.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const w = waterCopyFor(lang);
const home = lang === "te" ? "/te" : "/";
---

<Base {lang} slug="water-quality">
  <section class="relative overflow-hidden bg-navy-deep pt-36 pb-16 text-cream sm:pt-44 sm:pb-20">
    <div
      class="pointer-events-none absolute -right-24 -top-24 size-[26rem] rounded-full bg-lagoon/25 blur-[120px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-32 left-1/4 size-[22rem] rounded-full bg-paddy/15 blur-[120px]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto w-full max-w-6xl px-5">
      <nav aria-label="Breadcrumb" class="mb-8 text-[13px] font-semibold text-cream/55">
        <a href={home} class="hover:text-cream">{w.page.home}</a>
        <span class="px-1.5 text-cream/30" aria-hidden="true">/</span>
        <span aria-current="page">{w.page.kicker}</span>
      </nav>
      <p class="font-display text-[11px] font-bold uppercase tracking-[0.22em] text-lime">
        {w.page.kicker}
      </p>
      <h1
        class="mt-5 max-w-3xl font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl"
      >
        {w.page.h1}
      </h1>
      <p class="mt-6 max-w-[62ch] text-lg leading-8 text-cream/75 sm:text-xl">
        {w.page.lead}
      </p>
      <p class="mt-8 inline-flex items-center gap-2.5 text-[13px] font-semibold text-cream/70">
        <span class="size-2 rounded-full bg-lime" aria-hidden="true"></span>
        {WATER_ROW_COUNT} {w.page.facts}
      </p>
    </div>
  </section>

  <WaveDivider from="var(--color-navy-deep)" to="var(--color-cream)" />

  <section class="bg-cream pb-24 sm:pb-32">
    <div class="mx-auto w-full max-w-6xl px-5">
      <WaterTable {lang} />

      <div class="mt-8 grid gap-4 sm:grid-cols-[1.5fr_1fr]">
        <p class="rounded-2xl border-l-4 border-coral bg-bone p-5 text-[14px] leading-7 text-navy/80">
          {w.notes.warning}
        </p>
        <p class="rounded-2xl border border-navy/12 bg-bone/60 p-5 text-[14px] leading-7 text-navy/70">
          {w.notes.temperature}
        </p>
      </div>
    </div>
  </section>

  <WaveDivider from="var(--color-cream)" to="var(--color-navy)" />
  <VisitCta {lang} />
</Base>
