---
/** Products index page: the shelf index plus the amber price-note band. */
import Base from "@/layouts/Base.astro";
import type { Lang } from "@/content/aqua-copy";
import { pagesCopyFor } from "@/content/pages-copy";
import ShelfIndex from "@/sections/ShelfIndex.astro";
import WaveDivider from "@/components/WaveDivider.astro";
import VisitCta from "@/sections/VisitCta.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = pagesCopyFor(lang);
---

<Base {lang} slug="products">
  <section class="mx-auto w-full max-w-6xl px-5 pt-36 pb-4 sm:pt-44">
    <nav aria-label="Breadcrumb" class="mb-8 text-[13px] font-semibold text-navy-soft">
      <a href={lang === "te" ? "/te" : "/"} class="hover:text-navy">{p.nav.home}</a>
      <span class="px-1.5 text-navy/40" aria-hidden="true">/</span>
      <span aria-current="page">{p.nav.products}</span>
    </nav>
  </section>
  <ShelfIndex {lang} />
  <div class="bg-amber px-5 py-10 text-center">
    <p class="mx-auto max-w-[68ch] font-display text-lg font-bold leading-8 text-navy">
      {p.productsIndex.priceNote}
    </p>
  </div>
  <WaveDivider from="var(--color-amber)" to="var(--color-navy)" />
  <VisitCta {lang} />
</Base>
