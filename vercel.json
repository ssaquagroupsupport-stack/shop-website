{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    { "source": "/products", "destination": "/", "permanent": true },
    { "source": "/products/:shelf*", "destination": "/", "permanent": true },
    { "source": "/te/products", "destination": "/te", "permanent": true },
    { "source": "/te/products/:shelf*", "destination": "/te", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/:asset*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(robots.txt|llms.txt|llms-full.txt|manifest.webmanifest|data/brands.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
